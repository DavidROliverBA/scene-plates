{
  "title": "Approving an expense",
  "subtitle": "Simple flowchart: one decision, two outcomes",
  "description": "An expense claim is checked against a limit. Small claims are paid at once; larger ones go to a manager, who approves or refuses them.",
  "nodes": [
    {"id": "submit", "label": "SUBMIT CLAIM", "sub": "receipt attached", "at": [0, 0], "size": [2.6, 1], "icon": "document"},
    {"id": "limit", "label": "UNDER £500?", "sub": "automatic check", "kind": "gate", "at": [4, 0], "size": [2.6, 1], "icon": "check"},
    {"id": "pay", "label": "PAID", "sub": "in next payroll", "kind": "success", "at": [8, 0], "size": [2.6, 1], "icon": "card"},
    {"id": "manager", "label": "MANAGER", "sub": "reviews the claim", "at": [4, 2.2], "size": [2.6, 1], "icon": "user"},
    {"id": "refused", "label": "REFUSED", "sub": "sent back with reason", "kind": "fail", "at": [0, 2.2], "size": [2.6, 1], "icon": "stop"}
  ],
  "edges": [
    {"from": "submit", "to": "limit"},
    {"from": "limit", "to": "pay", "kind": "pass", "label": "yes"},
    {"from": "limit", "to": "manager", "label": "no"},
    {"from": "manager", "to": "pay", "kind": "pass", "via": "xy", "label": "approved"},
    {"from": "manager", "to": "refused", "kind": "fail", "label": "refused"}
  ],
  "callouts": [
    {"id": "why", "text": "The limit is a rule, not a judgement, so no person is needed here.", "on": "limit", "side": "up"}
  ],
  "steps": [
    {"caption": "Someone submits an expense claim.", "show": ["submit"]},
    {"caption": "Claims under £500 are checked automatically and paid.", "show": ["limit", "pay"], "pulse": ["submit>limit", "limit>pay"], "callout": ["why"]},
    {"caption": "Larger claims go to a manager.", "show": ["manager"], "focus": ["limit", "manager"], "pulse": ["limit>manager"]},
    {"caption": "The manager approves the claim, or refuses it with a reason.", "show": ["refused"], "focus": ["manager", "pay", "refused"], "pulse": ["manager>pay", "manager>refused"]},
    {"caption": "Two routes to being paid, one route to refusal."}
  ]
}
