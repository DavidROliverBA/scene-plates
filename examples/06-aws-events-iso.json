    { "id": "fn", "label": "LAMBDA", "sub": "applies the change", "at": [7.2, 0], "layer": 1 },
    { "id": "dlq", "label": "SQS DLQ", "sub": "kept for replay", "kind": "fail", "at": [10.8, 0], "layer": 1 },
    { "id": "table", "label": "DYNAMODB", "sub": "source of truth", "kind": "success", "at": [7.2, 0], "layer": 0 },
    { "id": "indexer", "label": "INDEXER", "sub": "lambda on stream", "at": [3.6, 0], "layer": 0 },
    { "id": "search", "label": "OPENSEARCH", "sub": "fast lookups", "kind": "quiet", "at": [0, 0], "layer": 0 }
  ],
  "groups": [
    { "id": "write", "label": "WRITE PATH", "contains": ["api", "fn", "dlq"] },
    { "id": "read", "label": "DATA AND SEARCH", "contains": ["table", "indexer", "search"] }
  ],
  "edges": [
    { "from": "client", "to": "api", "label": "POST" },
