    { "from": "table", "to": "indexer", "label": "stream" },
    { "from": "indexer", "to": "search", "label": "index" }
  ],
  "steps": [
    { "caption": "A client sends a change. API Gateway validates it first.", "show": ["client", "api"], "pulse": ["client>api"] },
    { "caption": "A Lambda function applies the change.", "show": ["fn"], "focus": ["api", "fn"], "pulse": ["api>fn"] },
    { "caption": "An event that fails three times is parked in a queue for replay.", "show": ["dlq"], "focus": ["fn", "dlq"], "pulse": ["fn>dlq"] },
    { "caption": "A good change is written to DynamoDB, the source of truth.", "show": ["table"], "focus": ["fn", "table"], "pulse": ["fn>table"] },
    { "caption": "The table's stream feeds an indexer, which keeps search up to date.", "show": ["indexer", "search"], "focus": ["read"], "pulse": ["table>indexer", "indexer>search"] },
