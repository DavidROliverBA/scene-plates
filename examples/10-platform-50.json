  "steps": [
    {"caption": "Fifty components in thirteen areas. Too many to read at once, so we tour it.", "show": ["shoppers", "blocked", "partners", "mobile", "web", "cdn", "waf", "apigw", "identity", "tokens", "keys", "cms", "media", "pricing", "productdb", "product", "search", "searchidx", "basket", "checkout", "fraud", "payment", "cardnet", "declined", "invoice", "ledger", "returns", "couriers", "shipping", "order", "orderdb", "inventory", "stockdb", "warehouse", "profile", "customerdb", "loyalty", "eventbus", "notifier", "emailsms", "support", "callcentre", "dashboards", "analyticsdb", "datalake", "loader", "monitoring", "logs", "secrets", "pipeline"]},
    {"caption": "Shoppers use the app or the web shop.", "camera": {"target": ["shoppers", "mobile", "web", "cdn"], "zoom": 2.4}, "pulse": ["shoppers>mobile", "shoppers>web"]},
    {"caption": "Everyone comes in the same way: through the firewall to one gateway.", "camera": {"target": ["web", "cdn", "waf", "apigw", "blocked"], "zoom": 2.4}, "pulse": ["web>cdn", "cdn>waf", "waf>apigw", "waf>blocked"], "callout": ["onedoor"]},
    {"caption": "The gateway asks identity who is calling before anything else runs.", "camera": {"target": ["apigw", "identity", "tokens", "keys"], "zoom": 2.4}, "pulse": ["apigw>identity", "identity>tokens"]},
    {"caption": "Browsing is served by the catalogue: product, price and search.", "camera": {"target": ["pricing", "productdb", "product", "search", "searchidx"], "zoom": 2.4}, "pulse": ["product>productdb", "product>search", "search>searchidx"]},
    {"caption": "Buying runs basket, checkout, a fraud check, then payment.", "camera": {"target": ["basket", "checkout", "fraud", "payment"], "zoom": 2.4}, "pulse": ["basket>checkout", "checkout>fraud", "fraud>payment"]},
    {"caption": "A risky order stops. A paid one is invoiced and written to the ledger.", "camera": {"target": ["payment", "cardnet", "declined", "invoice", "ledger"], "zoom": 2.4}, "pulse": ["fraud>declined", "payment>invoice", "invoice>ledger"], "callout": ["owner"]},
    {"caption": "Payment hands over to the order service, which owns the order from here.", "camera": {"target": ["shipping", "order", "orderdb", "inventory"], "zoom": 2.4}, "pulse": ["payment>order", "order>orderdb", "order>shipping", "order>inventory"]},
    {"caption": "Stock is counted in one place, fed by the warehouse.", "camera": {"target": ["orderdb", "inventory", "stockdb", "warehouse"], "zoom": 2.4}, "pulse": ["inventory>stockdb", "warehouse>stockdb"]},
    {"caption": "Every order change becomes an event. Messages and loyalty react to it.", "camera": {"target": ["loyalty", "eventbus", "notifier", "emailsms"], "zoom": 2.4}, "pulse": ["order>eventbus", "eventbus>notifier", "notifier>emailsms", "eventbus>loyalty"]},
    {"caption": "The same events fill the data lake and the dashboards.", "camera": {"target": ["dashboards", "analyticsdb", "datalake", "loader"], "zoom": 2.4}, "pulse": ["eventbus>loader", "loader>datalake", "datalake>analyticsdb", "analyticsdb>dashboards"]},
    {"caption": "Operations watch all of it: health, logs, secrets and releases.", "camera": {"target": ["monitoring", "logs", "secrets", "pipeline"], "zoom": 2.4}, "pulse": ["monitoring>logs", "pipeline>secrets"]},
    {"caption": "One way in, one owner per fact, and events to join the rest.", "camera": {"target": null, "zoom": 1}}
  ]
