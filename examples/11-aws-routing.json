  "callouts": [
    {"id": "slot", "text": "Same gap, two slots: 19.0 for one line, 19.3 for the other.", "on": "ecs", "side": "down", "gap": 30},
    {"id": "notdrawn", "text": "Every service logs to CloudWatch and is governed by IAM. That is 50 more lines, so it is said, not drawn.", "on": "iam", "side": "right", "gap": 34}
  ],
  "steps": [
    {"caption": "Twenty-seven services and twenty-nine lines, and no two lines cross.", "show": ["dns", "site", "ai", "athena", "lake", "cognito", "flow", "queue", "worker", "users", "cdn", "waf", "api", "fn", "table", "bus", "blocked", "alb", "ecs", "cache", "sns", "kms", "secrets", "watch", "iam", "sql", "ses"]},
    {"caption": "Rule 1: boxes that line up are joined by one straight line.", "camera": {"target": ["users", "cdn", "waf", "api", "fn"], "zoom": 2.0}, "pulse": ["users>cdn", "cdn>waf", "waf>api", "api>fn"]},
    {"caption": "Rule 2: lines leaving one box share a stem, then branch in the gap between columns.", "camera": {"target": ["waf", "site", "api", "alb", "blocked", "cognito"], "zoom": 2.0}, "pulse": ["waf>site", "waf>api", "waf>alb"]},
    {"caption": "Rule 3: lines arriving at the same box may join, because they end in the same place.", "camera": {"target": ["flow", "fn", "queue", "table"], "zoom": 2.0}, "pulse": ["flow>queue", "fn>queue", "api>fn", "alb>fn"]},
    {"caption": "The same three rules carry the work out to the queue, the worker and the data.", "camera": {"target": ["site", "ai", "athena", "lake", "flow", "queue", "worker"], "zoom": 2.0}, "pulse": ["flow>ai", "queue>worker", "worker>lake", "athena>lake"]},
    {"caption": "Rule 4: unrelated lines never share a path. Each turn gets its own slot in the gap.", "camera": {"target": ["fn", "ecs", "queue", "table", "cache", "sql"], "zoom": 2.0}, "pulse": ["fn>queue", "ecs>sql"], "callout": ["slot"]},
    {"caption": "Rule 5: one bend for up-and-across. A there-and-back pair runs side by side.", "camera": {"target": ["dns", "users", "cdn"], "zoom": 2.0}, "pulse": ["dns>cdn", "users>dns", "dns>users"]},
    {"caption": "Rule 6: to pass a box in the same row, a line drops into the gap between rows.", "camera": {"target": ["fn", "table", "bus", "ecs", "cache", "sns"], "zoom": 2.0}, "pulse": ["fn>bus"]},
    {"caption": "Data and messages end the flow: Aurora for records, SNS and SES for email.", "camera": {"target": ["cache", "sql", "sns", "ses"], "zoom": 2.0}, "pulse": ["ecs>sql", "bus>sns", "sns>ses"]},
    {"caption": "Rule 7: a line that would have to cross another is not drawn. It is stated instead.", "camera": {"target": ["kms", "secrets", "watch", "iam", "blocked"], "zoom": 2.0}, "focus": ["shared"], "callout": ["notdrawn"]},
    {"caption": "Lay boxes out in the order work flows, and most lines never need to cross.", "camera": {"target": null, "zoom": 1}}
  ]
}
