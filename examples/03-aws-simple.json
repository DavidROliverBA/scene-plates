    { "id": "site", "label": "S3", "sub": "the static pages", "kind": "quiet", "at": [7, -2.2] },
    { "id": "api", "label": "API GATEWAY", "sub": "checks each call", "kind": "gate", "at": [7, 0] },
    { "id": "fn", "label": "LAMBDA", "sub": "runs the logic", "at": [10.4, 0] },
    { "id": "table", "label": "DYNAMODB", "sub": "keeps the data", "kind": "success", "at": [10.4, 2.2] }
  ],
  "groups": [{ "id": "aws", "label": "AWS  eu-west-2", "contains": ["cdn", "site", "api", "fn", "table"] }],
  "edges": [
